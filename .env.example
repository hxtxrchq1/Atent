# ==========================================
# ATENT PLATFORM — ENVIRONMENT CONFIGURATION
# Rule 10: No real secrets in repository.
# ==========================================

# GLOBAL
NODE_ENV=development
LOG_LEVEL=debug

# APPS/API (NestJS)
API_PORT=3000
API_HOST=localhost
API_CORS_ORIGIN=http://localhost:3001

# DATABASE (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=atent_app
DATABASE_PASSWORD=local_dev_password_only
DATABASE_NAME=atent_db
DATABASE_SSL=false

# CACHE & EPHEMERAL SESSIONS (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SECURITY & TOKENS
JWT_SECRET=super_secret_dev_key_min_32_characters_long_example
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
EMERGENCY_LINK_TTL_MINUTES=60

# EXTERNAL SERVICES (SANDBOX MODE BY DEFAULT - RULE 7)
SMS_PROVIDER=sandbox
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_for_sandbox
TWILIO_AUTH_TOKEN=dummy_auth_token_for_sandbox
TWILIO_FROM_NUMBER=+15005550006

# TRANSACTIONAL EMAIL (RESEND)
EMAIL_PROVIDER=sandbox
RESEND_API_KEY=re_dummy_sandbox_api_key
RESEND_FROM_EMAIL=seguridad@atent.pe

# PUSH NOTIFICATIONS (FIREBASE CLOUD MESSAGING)
FCM_SERVER_KEY=dummy_fcm_server_key

# MAPS & GEOCODING
MAPS_PROVIDER=osm
MAPS_API_KEY=dummy_osm_key

# APPS/SAFETY-WEB (Next.js / Vite)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE=standard
