{
  "name": "@atent/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain models, contracts, and utilities for Atent",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    }
  },
  "dependencies": {
    "@atent/config": "*",
    "@atent/types": "*",
    "@atent/validation": "*",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "test": "node --test dist/*.test.js"
  },
  "keywords": [
    "atent",
    "shared",
    "types",
    "security"
  ],
  "author": "Atent Engineering Team",
  "license": "UNLICENSED"
}
